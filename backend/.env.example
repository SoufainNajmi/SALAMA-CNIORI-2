# Copier en .env (jamais versionné) et adapter si besoin.
# Valeurs par défaut alignées sur docker-compose.yml (base salama_user/salama_pw
# déjà exposée en clair dans ce fichier de dev — pas un vrai secret de prod).

PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=salama_user
DB_PASSWORD=salama_pw
DB_NAME=salama

# Générer une vraie valeur aléatoire avant tout déploiement au-delà du poste
# de dev (ex: openssl rand -hex 32).
JWT_SECRET=changez-moi-avant-la-prod

# Durée de validité du jeton (jours).
JWT_EXPIRES_IN_DAYS=7

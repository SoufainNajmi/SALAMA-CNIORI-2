    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.cniori.salama"
    },
    "android": {
      "package": "ma.cniori.salama"
    },
    "plugins": ["expo-router", "expo-localization", "expo-notifications"]
  }
}

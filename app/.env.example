# URL de base du backend SALAMA, sans slash final (ex : https://api.salama.ma).
# En dev local : http://localhost:4000 (voir backend/.env -> PORT). Sur un
# appareil physique via Expo Go, remplacer localhost par l'IP LAN du poste
# de dev. Si vide, l'app tourne sur les mocks (voir src/services/config.ts
# -> USE_MOCKS).
EXPO_PUBLIC_API_URL=
